{
  "name": "@sekai64-internal/large-scene",
  "version": "0.8.0-rc.54",
  "description": "Private optional Sekai64 shadow budgeting and spatial picking acceleration.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@sekai64-internal/lighting": "0.8.0-rc.54",
    "@sekai64-internal/math": "0.8.0-rc.54",
    "@sekai64-internal/modules": "0.8.0-rc.54",
    "@sekai64-internal/scene": "0.8.0-rc.54"
  },
  "license": "MIT",
  "author": "blcklab",
  "keywords": [
    "shadows",
    "spatial-index",
    "picking"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true
}
