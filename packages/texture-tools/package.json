{
  "name": "@sekai64-internal/texture-tools",
  "version": "0.8.0-rc.35",
  "description": "Private optional Sekai64 texture processing and decoder-adapter tools.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@sekai64-internal/materials": "0.8.0-rc.35"
  },
  "license": "MIT",
  "author": "blcklab",
  "keywords": [
    "textures",
    "mipmaps",
    "ktx2",
    "basis"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true
}
